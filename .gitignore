# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/.test-binary
/.test-npx

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude
.claude/*
!.claude/settings.json

# cursor
.cursor/*
!.cursor/hooks.json

# opencode
.opencode/*
!.opencode/opencode.json
!.opencode/plugins
.opencode/plugins/*
!.opencode/plugins/failproofai.mjs

# pi
.pi/*
!.pi/settings.json

# custom hooks loader temp files
*.__failproofai_tmp__.*

# package manager lockfiles (bun.lock is tracked; bun.lockb is binary)
package-lock.json

# translation cache
.translation-cache.json

# build artifacts from test scripts
*.tgz
/failproofai-local
packages/*/bin/
packages/*/assets/
.gstack/

# closed-source platform (cloned separately)
/platform

# rust
/target

# WSL/Windows alternate data streams
*:Zone.Identifier
.dev.log

# Local monitoring scratch files (CI run watchers etc.)
.monitor-*.sh
.monitor-*.log

# Local Mintlify dev server log (transient)
mint-dev.log

# superpowers brainstorm session scratch
.superpowers/

# transient commit-message scratch files
COMMIT_MSG.tmp

# integration-suite: decoded credentials during a local/CI run (the suite
# deletes both on exit, but a crashed run could leave them stageable)
/tokens/
/canary.env
/integration-suite-state.json
/cli-integration-state.json

# Compressed failproofaid binaries — produced by
# .github/workflows/build-daemon.yml (or a local `cargo build --release` +
# gzip for manual Docker verification), uploaded as release assets, never
# committed. Same for npm-pack tarballs produced anywhere in the repo during
# local packaging tests.
/failproofaid-*.gz
*.tgz

# Release-pipeline scratch. The publish workflow keeps both of these in
# RUNNER_TEMP — a build sweeps anything at the project root into
# .next/standalone — but a manual run (`gh release download --dir
# release-assets`, `build-daemon-packages.mjs --staging .daemon-packages`)
# lands them here.
/.daemon-packages/
/release-assets/

# Sandbox HOME directories from local/Docker smoke tests (see CLAUDE.md's
# testing protocol) leak into the repo when HOME points at a relative path
# instead of a real temp directory. A real one holds bun's install cache and
# this CLI's own runtime state, never source — and the parent directory name
# is random each time it happens (587d0567's committed ino.ujh3/ was one),
# so match the tell-tale contents anywhere in the tree rather than a name.
# The repo's own dogfood `/.failproofai/` (policies-config.json, policies/)
# has none of these subpaths, so it is unaffected.
**/.bun/install/cache/
**/.failproofai/bin/
**/.failproofai/run/
**/.failproofai/state/

# blog drafts (local, not for commit yet)
/blog/
