# Local Mintlify preview for docs/. Built by no workflow — run it by hand.
#
# The COPY below is repo-root-relative, so the build CONTEXT must be the repo
# root even though this file now lives in docs/:
#
#   docker build -f docs/Dockerfile.dev -t failproofai-docs .
#   docker run --rm -p 3000:3000 failproofai-docs
#
# Running it from inside docs/ fails with "docs/: not found".
FROM node:22-slim

RUN npm install -g mintlify

RUN useradd --create-home --uid 10001 docsuser
WORKDIR /app/docs
COPY --chown=docsuser:docsuser docs/ ./

USER docsuser
EXPOSE 3000

CMD ["mintlify", "dev", "--host", "0.0.0.0"]
