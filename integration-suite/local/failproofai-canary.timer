[Unit]
Description=Daily failproofai integration suite (canary)

[Timer]
# Same slot the retired GHA cron used (06:17 UTC) — off-peak for the gateway.
OnCalendar=*-*-* 06:17:00 UTC
# A box that was off (or asleep) at 06:17 runs the canary on the next boot
# instead of silently skipping the day.
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
