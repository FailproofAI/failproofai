{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/esm",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    // `@internal` exports (test hooks such as `_stats`, `_internals`,
    // `attach`) stay out of the published declarations: a name in a `.d.ts`
    // is a name a customer can come to depend on.
    "stripInternal": true
  },
  "include": ["src/**/*.ts"]
}
